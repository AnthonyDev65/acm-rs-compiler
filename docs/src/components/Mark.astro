---
// Símbolo de acm: el puntero (ratón) y el caret (teclado), lo que acm controla.
// El caret azul es el acento de la marca; con la clase `blink` parpadea como un cursor de texto.
interface Props { size?: number; class?: string; caret?: string }
const { size = 20, class: cls = "", caret = "#3291ff" } = Astro.props;
---

<svg class:list={["acm-mark", cls]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
  <path d="M3.75 2.75v14.6l3.9-3.6 2.65 5.95 2.45-1.1-2.65-5.9h5.5z" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
  <rect class="acm-caret" x="15.25" y="17.75" width="6" height="2.75" rx="0.5" fill={caret} />
</svg>

<style>
  .acm-mark { display: block; flex: none; }
  .blink .acm-caret, .acm-mark.blink .acm-caret { animation: acm-blink 1.06s steps(1) infinite; }
  @keyframes acm-blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .acm-caret { animation: none !important; } }
</style>
