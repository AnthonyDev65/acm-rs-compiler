---
import { u, REPO } from "../lib/url";
import { OSES } from "../lib/install";
import OsSwitch from "./OsSwitch.astro";

const steps = [
  { t: "Comprueba la instalación", d: "Abre una terminal nueva para que se cargue el PATH actualizado.", cmd: "acm --version" },
  { t: "Ejecuta tu primer script", d: "Como python: un archivo, código suelto con -e o la consola interactiva.", cmd: "acm -e 'PRINT \"hola\"'" },
];
---

<section class="start wrap" id="empezar">
  <div class="box reveal">
    <div class="head">
      <h2 class="h-section">Empieza en un minuto</h2>
      <div class="cta">
        <a class="btn btn-primary" href={u("/docs/#instalación")}>Guía de instalación</a>
        <a class="btn btn-secondary" href={`${REPO}/releases/latest`} target="_blank" rel="noopener">Descargar binarios</a>
      </div>
    </div>
    <OsSwitch class="switch" />
    <ol class="steps">
      <li>
        <span class="n mono">1</span>
        <h3>Instala acm</h3>
        {OSES.map((o) => (
          <>
            <p data-os-only={o.id}>{o.where}</p>
            <button type="button" class="cmd mono" data-os-only={o.id} data-copy={o.install} title={o.install} aria-label={`Copiar: ${o.install}`}>
              <span class="d">{o.prompt}</span> {o.install}
              <span class="done" aria-live="polite"></span>
            </button>
          </>
        ))}
      </li>
      {steps.map((s, i) => (
        <li>
          <span class="n mono">{i + 2}</span>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
          {OSES.map((o) => (
            <button type="button" class="cmd mono" data-os-only={o.id} data-copy={s.cmd} aria-label={`Copiar: ${s.cmd}`}>
              <span class="d">{o.prompt}</span> {s.cmd}
              <span class="done" aria-live="polite"></span>
            </button>
          ))}
        </li>
      ))}
    </ol>
    <p class="os">
      <span>Windows x64</span><span>macOS Intel y Apple Silicon</span><span>Linux x64 (X11)</span>
      <span class="sep">·</span>
      Navegador: Chrome, Edge o Brave
      <span class="sep">·</span>
      ¿Prefieres compilarlo? <code class="mono">cargo install --path .</code>
    </p>
  </div>
</section>

<style>
  .start { padding-top: 160px; }
  .box { border: 1px solid var(--line-2); border-radius: 20px; padding: clamp(28px, 5vw, 56px); background: radial-gradient(120% 80% at 100% 0%, rgba(10, 114, 239, 0.12), transparent 60%), var(--bg-1); }
  .head { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .box :global(.switch) { margin-top: 32px; }
  .steps { margin-top: 32px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .steps li { display: flex; flex-direction: column; gap: 8px; }
  .n { width: 28px; height: 28px; display: grid; place-items: center; border-radius: 50%; border: 1px solid var(--line-2); font-size: 12px; color: var(--fg-2); }
  .steps h3 { margin-top: 8px; font-size: 16px; font-weight: 600; }
  .steps p { font-size: 14px; color: var(--fg-2); flex: 1; }
  .cmd {
    position: relative; margin-top: 8px; text-align: left; padding: 12px 14px; border-radius: 10px; cursor: copy;
    background: #000; border: 1px solid var(--line-2); font-size: 13px; color: var(--fg);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; transition: border-color 150ms;
  }
  .cmd:hover { border-color: #4a4a4a; }
  .cmd .d { color: var(--fg-3); }
  .cmd .done { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); font-family: var(--sans); font-size: 12px; color: var(--green); background: #000; }
  .os { margin-top: 40px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 16px; font-size: 13px; color: var(--fg-3); }
  .os span:not(.sep) { color: var(--fg-2); }
  .os code { font-size: 12px; color: var(--fg-2); }
  @media (max-width: 860px) { .steps { grid-template-columns: minmax(0, 1fr); } .start { padding-top: 112px; } }
</style>
