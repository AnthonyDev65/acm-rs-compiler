---
import Base from "../../layouts/Base.astro";
import * as readme from "../../../../README.md";
import { REPO } from "../../lib/url";

const headings = readme.getHeadings().filter((h) => h.depth === 2 || h.depth === 3);
---

<Base title="Documentación — acm">
  <div class="docs wrap">
    <aside class="toc">
      <nav aria-label="En esta página">
        <p class="toc-title">Documentación</p>
        <ul>
          {headings.map((h) => (
            <li class={`d${h.depth}`}><a href={`#${h.slug}`} data-slug={h.slug}>{h.text}</a></li>
          ))}
        </ul>
      </nav>
    </aside>

    <article class="prose">
      <readme.Content />
      <p class="edit"><a href={`${REPO}/blob/main/README.md`} target="_blank" rel="noopener">Editar esta página en GitHub ↗</a></p>
    </article>
  </div>
</Base>

<style>
  .docs { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 64px; padding-top: 48px; }
  .toc { position: sticky; top: 88px; align-self: start; max-height: calc(100vh - 110px); overflow: auto; padding-bottom: 24px; }
  .toc-title { font-size: 13px; font-weight: 600; margin-bottom: 12px; }
  .toc li a { display: block; padding: 5px 0 5px 12px; font-size: 14px; color: var(--fg-2); border-left: 1px solid var(--line); transition: color 150ms, border-color 150ms; }
  .toc li.d3 a { padding-left: 24px; font-size: 13px; }
  .toc li a:hover { color: var(--fg); }
  .toc li a.on { color: var(--fg); border-left-color: var(--blue-2); }

  .prose { max-width: 820px; min-width: 0; padding-bottom: 40px; }
  .prose :global(h1) { font-size: clamp(2.25rem, 1.5rem + 2.5vw, 3rem); font-weight: 600; letter-spacing: -0.05em; line-height: 1.1; margin-bottom: 20px; }
  .prose :global(h2) { font-size: 28px; font-weight: 600; letter-spacing: -0.035em; line-height: 1.2; margin: 72px 0 18px; padding-top: 24px; border-top: 1px solid var(--line); scroll-margin-top: 80px; }
  .prose :global(h3) { font-size: 20px; font-weight: 600; letter-spacing: -0.02em; margin: 44px 0 14px; scroll-margin-top: 80px; }
  .prose :global(hr) { display: none; }
  .prose :global(p), .prose :global(li) { color: #cfcfcf; font-size: 16px; line-height: 1.75; }
  .prose :global(p) { margin: 14px 0; }
  .prose :global(strong) { color: var(--fg); }
  .prose :global(a) { color: var(--blue-2); text-decoration: underline; text-decoration-color: rgba(50,145,255,0.4); text-underline-offset: 3px; }
  .prose :global(ul), .prose :global(ol) { margin: 14px 0; padding-left: 22px; }
  .prose :global(ul) { list-style: disc; }
  .prose :global(ol) { list-style: decimal; }
  .prose :global(li) { margin: 4px 0; }
  .prose :global(li::marker) { color: var(--fg-3); }
  .prose :global(:not(pre) > code) { font-size: 0.86em; padding: 2px 6px; border-radius: 6px; background: var(--bg-3); border: 1px solid var(--line); color: var(--fg); white-space: nowrap; }
  .prose :global(td code) { white-space: normal; }
  .prose :global(pre) { margin: 20px 0; padding: 18px 20px; border-radius: var(--radius); border: 1px solid var(--line-2); background: var(--bg-1) !important; font-size: 13px; line-height: 1.7; overflow-x: auto; }
  .prose :global(table) { width: 100%; margin: 20px 0; border-collapse: collapse; font-size: 14px; display: block; overflow-x: auto; }
  .prose :global(th) { text-align: left; font-weight: 500; color: var(--fg-2); padding: 10px 14px; border-bottom: 1px solid var(--line-2); white-space: nowrap; }
  .prose :global(td) { padding: 10px 14px; border-bottom: 1px solid var(--line); vertical-align: top; color: #cfcfcf; line-height: 1.6; }
  .prose :global(tr:hover td) { background: var(--bg-1); }
  .prose :global(blockquote) { margin: 20px 0; padding: 12px 16px; border-left: 2px solid var(--amber); background: rgba(245,165,36,0.06); border-radius: 0 8px 8px 0; }
  .prose :global(blockquote p) { margin: 0; }
  .edit { margin-top: 64px !important; font-size: 14px !important; }

  @media (max-width: 900px) {
    .docs { grid-template-columns: 1fr; gap: 0; }
    .toc { display: none; }
  }
</style>

<script>
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>(".toc a")].map((a) => [a.dataset.slug!, a]));
  const io = new IntersectionObserver((es) => {
    for (const e of es) if (e.isIntersecting) {
      links.forEach((a) => a.classList.remove("on"));
      const a = links.get(e.target.id);
      if (a) { a.classList.add("on"); a.scrollIntoView({ block: "nearest" }); }
    }
  }, { rootMargin: "-80px 0px -70% 0px" });
  document.querySelectorAll(".prose h2[id], .prose h3[id]").forEach((h) => io.observe(h));
</script>
