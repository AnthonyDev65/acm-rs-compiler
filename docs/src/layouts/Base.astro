---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { u } from "../lib/url";

interface Props { title: string; description?: string }
const {
  title,
  description = "acm es un lenguaje de automatización escrito en Rust: ratón, teclado, ventanas, portapapeles y Chrome con una sintaxis legible, salida JSON para agentes de IA y modo simulación.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={u("/favicon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300..800&family=Geist+Mono:wght@400..600&display=swap" rel="stylesheet" />
    <script is:inline>
      // Sistema para los comandos de instalación: el elegido antes, o el detectado.
      (function () {
        var os = null;
        try { os = localStorage.getItem("acm-os"); } catch (e) {}
        if (os !== "windows" && os !== "macos" && os !== "linux") {
          var p = ((navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || navigator.userAgent).toLowerCase();
          os = /mac|iphone|ipad/.test(p) ? "macos" : /linux|x11|android|cros|chrome os/.test(p) ? "linux" : "windows";
        }
        document.documentElement.dataset.os = os;
      })();
    </script>
  </head>
  <body>
    <Nav />
    <slot />
    <Footer />
    <script>
      const io = new IntersectionObserver((es) => {
        for (const e of es) if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
      }, { rootMargin: "0px 0px -10% 0px" });
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
