{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix docs",
  "buildCommand": "npm run build --prefix docs",
  "outputDirectory": "docs/dist",
  "cleanUrls": true,
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- docs examples README.md vercel.json"
}
